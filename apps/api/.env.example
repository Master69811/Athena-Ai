# ──────────────────────────────────────────────────────────────
# Athena AI — Environment Variables
# Copy to .env and fill in real values before starting.
# ──────────────────────────────────────────────────────────────

# Database
DATABASE_URL="postgresql://athena:CHANGE_ME_DB_PASSWORD@localhost:5432/athena_db"
REDIS_URL="redis://localhost:6379"
QDRANT_URL="http://localhost:6333"
# Only needed for Qdrant Cloud (cloud.qdrant.io) — leave empty for local Docker
QDRANT_API_KEY=""

# ⚠ JWT — generate with: openssl rand -base64 64
# Must be ≥ 32 chars and NEVER the placeholder value.
# The app refuses to start in production with placeholder values.
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_64"
JWT_REFRESH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_64_different_value"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI APIs
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.0-flash"

# OAuth (optional)
GOOGLE_CLIENT_ID="CHANGE_ME_google_client_id"
GOOGLE_CLIENT_SECRET="CHANGE_ME_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# AWS S3 (optional — for media uploads)
AWS_ACCESS_KEY_ID="CHANGE_ME_aws_key"
AWS_SECRET_ACCESS_KEY="CHANGE_ME_aws_secret"
AWS_REGION="eu-west-1"
AWS_S3_BUCKET="athena-ai-media"

# Stripe (optional — for subscriptions)
STRIPE_SECRET_KEY="sk_test_CHANGE_ME"
STRIPE_PUBLISHABLE_KEY="pk_test_CHANGE_ME"
STRIPE_WEBHOOK_SECRET="whsec_CHANGE_ME"

# App
FRONTEND_URL="http://localhost:3000"
PORT=3001
NODE_ENV="development"
